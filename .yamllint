---
extends: default

ignore:
  - /node_modules/
  - /.ansible/
  - /.venv/
  - /.forgejo/
  - /.vscode/
  - .yamllint
  - .cache_ggshield

rules:
  line-length:
    max: 160
    level: warning
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
