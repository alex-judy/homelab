{
    "extends": [
        "config:recommended"
    ],
    "configMigration": true,
    "timezone": "UTC",
    "schedule": [
        "after 5am"
    ],
    "enabledManagers": [
        "docker-compose"
    ],
    "packageRules": [
        {
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "*"
            ],
            "groupName": "docker container updates",
            "groupSlug": "docker-container-updates"
        },
        {
            "matchDatasources": [
                "docker"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch",
                "digest"
            ],
            "automerge": true,
            "automergeType": "pr",
            "platformAutomerge": true
        },
        {
            "matchDatasources": [
                "docker"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "groupName": "docker major updates",
            "groupSlug": "docker-major-updates",
            "automerge": false
        }
    ]
}
