{
    "extends": [
        "config:recommended"
    ],
    "timezone": "UTC",
    "schedule": [
        "after 5am every day"
    ],
    "enabledManagers": [
        "docker-compose"
    ],
    "packageRules": [
        {
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "*"
            ],
            "groupName": "docker container updates",
            "groupSlug": "docker-container-updates"
        }
    ]
}