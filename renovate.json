{
    "extends": [
        "config:recommended",
        "schedule:automergeDaily", 
        ":dependencyDashboard",
        "abandonments:recommended"
    ],
    "configMigration": true,
    "timezone": "UTC",
    "enabledManagers": [
        "docker-compose",
        "dockerfile",
        "custom.regex"
    ],
    "registryAliases": {
        "lscr.io": "ghcr.io"
    },
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/(^|/)Dockerfile$/"
            ],
            "matchStrings": [
                "ARG CODEQL_BUNDLE_TAG=(?<currentValue>codeql-bundle-v[\\d.]+)"
            ],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "github/codeql-action",
            "extractVersionTemplate": "^codeql-bundle-v(?<version>.*)$"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/(^|/)Dockerfile$/"
            ],
            "matchStrings": [
                "ARG ACTIONLINT_VERSION=(?<currentValue>[\\d.]+)"
            ],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "rhysd/actionlint"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/(^|/)Dockerfile$/"
            ],
            "matchStrings": [
                "ARG HADOLINT_VERSION=(?<currentValue>[\\d.]+)"
            ],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "hadolint/hadolint"
        }
    ],
    "packageRules": [
        {
            "description": "Exclude LinuxServer legacy Ubuntu-base tags (YY.04/YY.10) for image consistency",
            "matchDatasources": ["docker"],
            "matchPackageNames": [
                "linuxserver/**",
                "lscr.io/linuxserver/**",
                "ghcr.io/linuxserver/**"
            ],
            "allowedVersions": "!/^\\d{2}\\.(04|10)(\\.\\d+)?$/"
        },
        {
            "description": "Group all Docker container updates",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "*"
            ],
            "groupName": "docker container updates",
            "groupSlug": "docker-container-updates"
        },
        {
            "description": "Automatically merge Docker minor, patch, and digest updates",
            "matchDatasources": [
                "docker"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch",
                "digest"
            ],
            "automerge": true,
            "automergeType": "pr",
            "platformAutomerge": true
        },
        {
            "description": "Keep Docker major updates separate and require manual review",
            "matchDatasources": [
                "docker"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "groupName": "docker major updates",
            "groupSlug": "docker-major-updates",
            "automerge": false
        },
        {
            "description": "Group CodeQL bundle updates",
            "matchDatasources": [
                "github-releases"
            ],
            "matchPackageNames": [
                "github/codeql-action"
            ],
            "groupName": "codeql bundle",
            "groupSlug": "codeql-bundle",
            "automerge": false
        }
    ]
}