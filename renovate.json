{
    "extends": [
        "config:recommended"
    ],
    "configMigration": true,
    "timezone": "UTC",
    "schedule": [
        "after 5am"
    ],
    "enabledManagers": [
        "docker-compose",
        "dockerfile",
        "custom.regex"
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/(^|/)Dockerfile$/"
            ],
            "matchStrings": [
                "ARG CODEQL_BUNDLE_TAG=(?<currentValue>codeql-bundle-v[\\d.]+)"
            ],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "github/codeql-action",
            "extractVersionTemplate": "^codeql-bundle-v(?<version>.*)$"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/(^|/)Dockerfile$/"
            ],
            "matchStrings": [
                "ARG ACTIONLINT_VERSION=(?<currentValue>[\\d.]+)"
            ],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "rhysd/actionlint"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/(^|/)Dockerfile$/"
            ],
            "matchStrings": [
                "ARG HADOLINT_VERSION=(?<currentValue>[\\d.]+)"
            ],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "hadolint/hadolint"
        }
    ],
    "packageRules": [
        {
            "matchDatasources": ["docker"],
            "matchPackagePatterns": [
              "^lscr\\.io\\/linuxserver\\/"
            ],
            "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?(?:_v\\d+\\.\\d+\\.\\d+)?(?:-ls(?<revision>\\d+))?$",
            "separateMajorMinor": true,
            "minimumReleaseAge": "3 days"
        },
        {
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "*"
            ],
            "groupName": "docker container updates",
            "groupSlug": "docker-container-updates"
        },
        {
            "matchDatasources": [
                "docker"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch",
                "digest"
            ],
            "automerge": true,
            "automergeType": "pr",
            "platformAutomerge": true
        },
        {
            "matchDatasources": [
                "docker"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "groupName": "docker major updates",
            "groupSlug": "docker-major-updates",
            "automerge": false
        },
        {
            "matchDatasources": [
                "github-releases"
            ],
            "matchPackageNames": [
                "github/codeql-action"
            ],
            "groupName": "codeql bundle",
            "groupSlug": "codeql-bundle",
            "automerge": false
        }
    ]
}
